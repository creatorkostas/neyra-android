  "narrative": {
    "northStar": "Forest connection",
    "overview": "A private thought travels from this phone to one chosen computer. Deep forest chrome frames lichen working surfaces; citron gives selection a distinct voice. The Nordic cultural identity direction is expressed through palette, bundled type and one geometric connection signature.\n\nThis is an Android task interface: native Material 3 controls, explicit destinations and editable drafts carry the work. Speed and privacy guide the design; neither physical-device performance nor hardware behavior is established by this documentation.",
    "keyCharacteristics": [
      "Forest chrome, lichen surfaces and citron emphasis.",
      "Bundled Manrope with native Android controls.",
      "Visible destination, a two-control home and text-backed connection geometry in Compose."
    ],
    "rules": [
      {
        "name": "The Visible Destination Rule",
        "body": "Show the selected computer before capture and name it in the send action; never silently retarget queued work.",
        "section": "colors"
      },
      {
        "name": "The Honest Connection Rule",
        "body": "Use a solid path online and a broken path offline, always with explicit connection text. Geometry does not imply pairing or live audio.",
        "section": "components"
      },
      {
        "name": "The Native Interaction Rule",
        "body": "Keep Material controls, Android font scaling, scrolling, IME clearance and accessible action labels.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do keep Capture to the computer dropdown followed by Speak; keep secondary capture and review controls in Compose.",
      "Do preserve draft text, mode and original speech target across navigation and destination changes.",
      "Do keep recording/provider disclosures, queue consent and notification-delay limits readable.",
      "Do retain search, outbox retry/deletion confirmation, reminder actions, pairing and conversation playback/Stop."
    ],
    "donts": [
      "Don't send imported text automatically or send a speech draft to a changed computer without editing/review or restoring its original target.",
      "Don't treat discovery as pairing or disconnected computers as connected.",
      "Don't add fetched decorative media, blur, perpetual animation or claims of fully local provider conversations."
    ]
