  "narrative": {
    "northStar": "Your voice, your computer",
    "overview": "Neyra’s calm ink and warm-surface identity becomes a native Material 3 remote for the user’s own computers. System typography, quiet tonal grouping and familiar controls keep capture and connection state readable.\n\nThe selected computer is visible before capture. Recordings and shared text lead to an editable review draft rather than silently dispatching an action; local-network and notification limits remain explicit.",
    "keyCharacteristics": [
      "Ink accents on warm neutral surfaces.",
      "Native Material 3 controls and system typography.",
      "Visible destination and honest connection state."
    ],
    "rules": [
      {
        "name": "The Visible Destination Rule",
        "body": "Keep the selected computer and connection state visible before capture; name the destination in the send action.",
        "section": "colors"
      },
      {
        "name": "The Native Type Rule",
        "body": "Use Material typography roles and Android font scaling rather than fixed pixel text or a decorative display face.",
        "section": "typography"
      },
      {
        "name": "The Tonal Grouping Rule",
        "body": "Use native tonal surfaces for grouping; do not add decorative hard shadows to the destination panel.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve system font scaling, scrolling, IME clearance and native touch targets.",
      "Do retain draft text, mode and original speech target across destination changes and keep queued destinations explicit.",
      "Do keep recording/provider privacy disclosures, queue consent and notification-delay limits readable."
    ],
    "donts": [
      "Don't treat discovery as pairing or an offline computer as connected.",
      "Don't send a spoken draft to a changed computer until it is reviewed/edited or the original destination is restored.",
      "Don't replace native controls with web styling or introduce custom entrance animation."
    ]
  }
}
